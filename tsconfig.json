{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "types": ["@types/node", "@playwright/test"]
  },
  "include": [
    "types/playwright.d.ts",
    "playwright.config.ts",
    "cfg/**/*.ts",
    "tests/**/*.ts",
    "apps/**/*.ts",
    "locators/**/*.ts",
    "pages/**/*.ts",
    "change-injection/**/*.ts"
  ]
}
